# --- Live flight data: Duffel (https://duffel.com). Create an account and copy an access token.
# Test tokens start with duffel_test_, live tokens with duffel_live_.
DUFFEL_ACCESS_TOKEN=

# --- Live hotel data: LiteAPI (https://liteapi.travel). Create an account and copy the API key.
LITEAPI_KEY=
# Default guest nationality (ISO country code) sent with hotel rate searches
HOTEL_GUEST_NATIONALITY=PK

# --- Email (order notifications). Leave empty to only log orders to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address that receives new orders
ORDER_NOTIFY_EMAIL=
# "From" address for outgoing mail
MAIL_FROM=
