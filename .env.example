# --- Live flights and airports: LiteAPI / Nuitee Connect (https://liteapi.travel).
# Create an account and copy the API key. The sandbox key gives test data; the production key gives
# live data. Flights in production need approval from LiteAPI ("Getting Access to Flights").
LITEAPI_KEY=
# (Optional when DUFFEL_ACCESS_TOKEN is set: flights and airport search then come from Duffel.)

# --- Flight hold bookings: Duffel (https://app.duffel.com → Developers → Access tokens).
# When set, flight search shows only flights that can be held, and each order creates a hold order
# (real airline booking reference, paid later or left to expire). Use duffel_test_... first: free.
DUFFEL_ACCESS_TOKEN=
# Set to "liteapi" to use LiteAPI for flights even when a Duffel token is set (orders are then booked by hand).
FLIGHT_PROVIDER=
# Country code added to phone numbers typed without one (e.g. 0300... → +92300...). Default 92 (Pakistan).
DEFAULT_PHONE_COUNTRY_CODE=92
# With a duffel_live_ token, orders only create real (billed) bookings when this is "on".
DUFFEL_LIVE_HOLDS=off

# --- Email (order notifications). Leave empty to only log orders to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address that receives new orders
ORDER_NOTIFY_EMAIL=
# "From" address for outgoing mail
MAIL_FROM=

# --- Payments: Stripe (https://dashboard.stripe.com/apikeys). Leave empty to take orders without payment.
# Use sk_test_... for testing and sk_live_... once your Stripe account is activated.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://YOUR-SITE/api/stripe-webhook (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
# Optional: your public site address, used for Stripe's return links (defaults to the request's address)
NEXT_PUBLIC_SITE_URL=
# Optional: charge this flat amount for every order (e.g. 1) to run a real-money payment test. Remove afterwards.
TEST_ORDER_PRICE=
